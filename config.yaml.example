# --- MQTT ---
mqtt:
  broker: localhost
  port: 1883
  username: elmet
  password: cambia_esto

# Perfiles de dispositivo cuyos mensajes se procesan
allowed_profiles:
  - RADIO_LIB
  - Sense V1
  - SENSEV2_TEST
  - REAID MUV V1 - ABP
  - IRIS_V1_AC

# --- Endpoint web ---
endpoint:
  url: https://apis.maind.cl/api/reading/webhook_dispositivos

# Origen del id de dispositivo:
#   database -> consulta la tabla 'dispositivos' en MariaDB (usa la sección database)
#   config   -> usa el mapa 'devices' definido más abajo (no requiere base de datos)
# OPCIONAL: si se omite, se decide solo con prioridad BD > config (hay
# sección `database` con host -> database; si no -> config).
# device_id_source: database

# Mapa nombre de dispositivo -> id. Solo se usa si device_id_source: config
devices:
  # nombre-del-dispositivo-en-chirpstack: 123
  # otro-dispositivo: 456

# --- MariaDB (solo si device_id_source: database) ---
database:
  host: 10.0.3.147
  port: 3306
  user: cambia_esto
  password: cambia_esto
  name: cambia_esto

# Guardar los datos en disco antes de enviarlos (buffer offline)
save_data: false
